# Android Release Keystore Configuration
# =========================================
# HOW TO USE:
#   1. Copy this file:  cp keystore.properties.example keystore.properties
#   2. Fill in your actual keystore credentials below.
#   3. keystore.properties is gitignored — NEVER commit it.
#
# HOW TO GENERATE A RELEASE KEYSTORE:
#   keytool -genkey -v \
#     -keystore android/app/release.keystore \
#     -alias my-key-alias \
#     -keyalg RSA \
#     -keysize 2048 \
#     -validity 10000
# =========================================

RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
